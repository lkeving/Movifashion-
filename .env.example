# =====================================================================
# MOVIFASHION AI: Environment Configuration (.env.example)
# Copy this file to .env and configure your production credentials.
# =====================================================================

# Server Port
PORT=3000
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini 3.8 Flash AI Stylist and Visual Search
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base host URL
APP_URL="http://localhost:3000"

# Supabase (Server-side persistence for PostgreSQL & Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret for Session Cookies & Bearer Tokens (Minimum 32 characters)
JWT_SECRET="movifashion-secure-jwt-secret-token-2026-production"

# Administrator Default Credentials
ADMIN_EMAIL="admin@movifashion.ai"
ADMIN_PASSWORD="AdminSecurePass2026!"
